{
  "name": "Family Budget",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:20",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Family Budget App",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "cp -n .env.example .env 2>/dev/null || true; npm install && npx prisma generate && npx prisma db push && npx tsx prisma/seed.ts",
  "postStartCommand": "npm run dev",
  "customizations": {
    "vscode": {
      "extensions": [
        "Prisma.prisma",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
