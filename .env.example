# Токен бота от @BotFather (обязательно)
BOT_TOKEN="123456789:AAExampleBotTokenHere"

# Ваш Telegram ID (узнать можно через @userinfobot). Можно несколько через запятую.
ADMIN_TELEGRAM_ID="123456789"

# Опционально: фиксированный инвайт-код для первой инициализации (иначе сгенерируется случайно)
# INVITE_CODE="my-secret-santa-2026"

# Локальная БД SQLite (по умолчанию ./data/santa.db)
# Для Render / облака лучше указать PostgreSQL (postgres://... или postgresql://...)
SQLITE_PATH="./data/santa.db"
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Порт HTTP-сервера (/health, /api/health и webhook)
PORT="3000"

# На Render переменная RENDER_EXTERNAL_URL подставляется автоматически,
# поэтому бот сам переключится в режим Webhook. Локально оставьте пустым (будет Long Polling).
# WEBHOOK_URL="https://your-service.onrender.com"
